# Copiar a .env; NO subir .env al repositorio.
# Preflight NO despliega recursos. PROJECT_ID obligatorio para conexión.
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
BQ_LOCATION="US"
ENVIRONMENT="lab"
RESOURCE_PREFIX="retailsmart"
# Parámetros de límites. No habilitan presupuesto automáticamente.
MAX_ESTIMATED_DAILY_USD="10"
